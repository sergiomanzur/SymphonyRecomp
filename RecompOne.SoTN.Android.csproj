<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.blacklabelhq.sotn</ApplicationId>
    <!-- ApplicationVersion is the integer versionCode Android compares on update, so it only
         ever goes up. ApplicationDisplayVersion is what players see. -->
    <ApplicationVersion>12</ApplicationVersion>
    <ApplicationDisplayVersion>0.10.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidGenerateAppBundle>false</AndroidGenerateAppBundle>
    <UseFlagsAttributeForFlags>true</UseFlagsAttributeForFlags>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- Exclude desktop Program.cs and the RecompOne submodule folder.
         extras/** holds mod source, which is compiled at runtime by Roslyn and must never be
         compiled into the app: the default **/*.cs glob would otherwise pull it in, where
         Sotn.Button collides with Android.Widget.Button and the mod's types would end up in
         both the app assembly and the runtime-built mod assembly. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);RecompOne/**;Program.cs;jdk/**;extras/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="RecompOne\RecompOne.Runtime\RecompOne.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Mods are C# source compiled on device, so the compiler and everything a mod might
       reference has to survive the linker. Without these the trimmer can drop Roslyn's
       internals, or strip types a mod compiles against that nothing else calls. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.CodeAnalysis" RootMode="all" />
    <TrimmerRootAssembly Include="Microsoft.CodeAnalysis.CSharp" RootMode="all" />
    <TrimmerRootAssembly Include="RecompOne.Runtime" RootMode="all" />
    <TrimmerRootAssembly Include="RecompOne.SoTN.Android" RootMode="all" />
  </ItemGroup>

  <!-- Embed tracker, map, extension, and icon resources directly -->
  <ItemGroup>
    <EmbeddedResource Include="assets/tracker/*.png" />
    <EmbeddedResource Include="assets/map/*.png" />
    <EmbeddedResource Include="assets/extension/*.png" />
    <EmbeddedResource Include="assets/icon/*.ico" />
  </ItemGroup>

  <!-- Android App Icons -->
  <ItemGroup>
    <AndroidResource Include="Android\Resources\**\*.png" />
  </ItemGroup>

  <!-- Assets to copy to the device at runtime -->
  <ItemGroup>
    <AndroidAsset Include="assets\**\*" />
    <AndroidAsset Include="config\**\*" />
    <AndroidAsset Include="Android\*.png" />
    <!-- The disc is deliberately NOT packaged. Bundling it made the APK ~470 MB and baked the
         builder's own dump into every copy. DiscImporter asks the player for their files on
         first launch instead. -->

    <!-- Ship the bundled mods. The submodule git metadata would otherwise be packaged too. -->
    <AndroidAsset Include="mods\**\*"
                  Exclude="mods\.git\**;mods\**\.git\**;mods\**\.git;mods\.gitignore;mods\.gitmodules;mods\.cache\**" />

    <!-- Mods this repository owns, kept out of the mods/ submodule (which belongs to
         BlackLabelHQ). Linked into the mods/ asset path so CopyAssets("mods") unpacks them
         next to the submodule's own, exactly as if they had shipped together. -->
    <AndroidAsset Include="extras\mods\**\*" Exclude="extras\mods\**\.cache\**">
      <Link>mods\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>
</Project>
